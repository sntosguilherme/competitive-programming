{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar C++ (bin)",
            "command": "if (-not (Test-Path 'bin')) { New-Item -ItemType Directory -Path 'bin' }; g++ -fdiagnostics-color=always -g \"${file}\" -o \"${workspaceFolder}/bin/${fileBasenameNoExtension}.exe\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}